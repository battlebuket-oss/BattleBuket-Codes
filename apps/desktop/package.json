{
  "name": "@battlebuket/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dist:win": "pnpm build && electron-builder --win nsis --publish never",
    "dist:mac": "pnpm build && electron-builder --mac dmg --publish never",
    "dist:linux": "pnpm build && electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@battlebuket/agent-contracts": "workspace:*",
    "@battlebuket/engineering-director": "workspace:*",
    "@battlebuket/virtual-team": "workspace:*",
    "@battlebuket/provider-adapters": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-vite": "6.0.0",
    "typescript": "^5.7.3",
    "vite": "8.3.8",
    "tsx": "^4.23.15",
    "electron-builder": "26.18.1"
  },
  "main": "out/main/index.js",
  "build": {
    "appId": "com.battlebuket.codes",
    "productName": "BattleBuket Codes",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "artifactName": "BattleBuket-Codes-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "executableName": "battlebuket-codes",
      "syncDesktopName": true
    },
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk*/**"
    ],
    "executableName": "battlebuket-codes"
  },
  "description": "A local-first AI-assisted software engineering workspace.",
  "author": "BattleBuket Studios",
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.331",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.331",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "0.3.331",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "0.3.331",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "0.3.331",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "0.3.331",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "0.3.331",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.331"
  },
  "desktopName": "com.battlebuket.codes"
}
