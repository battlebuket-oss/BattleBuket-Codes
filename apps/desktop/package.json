{
  "name": "@battlebuket/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dist:win": "pnpm build && electron-builder --win nsis --publish never",
    "dist:mac": "pnpm build && electron-builder --mac dmg --publish never",
    "dist:linux": "pnpm build && electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@battlebuket/agent-contracts": "workspace:*",
    "@battlebuket/engineering-director": "workspace:*",
    "@battlebuket/virtual-team": "workspace:*",
    "@battlebuket/provider-adapters": "workspace:*",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "node-pty": "1.1.0",
    "@monaco-editor/react": "4.7.0",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@37.6.0",
    "@codingame/monaco-vscode-api": "37.6.0",
    "@codingame/monaco-vscode-all-language-feature-default-extensions": "37.6.0",
    "@codingame/monaco-vscode-configuration-service-override": "37.6.0",
    "@codingame/monaco-vscode-editor-api": "37.6.0",
    "@codingame/monaco-vscode-extension-api": "37.6.0",
    "@codingame/monaco-vscode-explorer-service-override": "37.6.0",
    "@codingame/monaco-vscode-keybindings-service-override": "37.6.0",
    "@codingame/monaco-vscode-languages-service-override": "37.6.0",
    "@codingame/monaco-vscode-lifecycle-service-override": "37.6.0",
    "@codingame/monaco-vscode-log-service-override": "37.6.0",
    "@codingame/monaco-vscode-markers-service-override": "37.6.0",
    "@codingame/monaco-vscode-model-service-override": "37.6.0",
    "@codingame/monaco-vscode-search-service-override": "37.6.0",
    "@codingame/monaco-vscode-terminal-service-override": "37.6.0",
    "@codingame/monaco-vscode-textmate-service-override": "37.6.0",
    "@codingame/monaco-vscode-theme-service-override": "37.6.0",
    "@codingame/monaco-vscode-workbench-service-override": "37.6.0",
    "@codingame/monaco-vscode-workspace-trust-service-override": "37.6.0",
    "monaco-languageclient": "11.0.3",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@37.6.0",
    "@codingame/monaco-vscode-files-service-override": "37.6.0",
    "@codingame/monaco-vscode-base-service-override": "37.6.0",
    "@codingame/monaco-vscode-extensions-service-override": "37.6.0",
    "@codingame/monaco-vscode-host-service-override": "37.6.0",
    "@codingame/monaco-vscode-quickaccess-service-override": "37.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-vite": "6.0.0",
    "typescript": "^5.7.3",
    "vite": "8.3.8",
    "tsx": "^4.23.15",
    "electron-builder": "26.18.1"
  },
  "main": "out/main/index.js",
  "build": {
    "appId": "com.battlebuket.codes",
    "productName": "BattleBuket Codes",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "artifactName": "BattleBuket-Codes-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "forceCodeSigning": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "executableName": "battlebuket-codes",
      "syncDesktopName": true
    },
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk*/**",
      "node_modules/node-pty/**/*"
    ],
    "executableName": "battlebuket-codes"
  },
  "description": "A local-first AI-assisted software engineering workspace.",
  "author": "BattleBuket Studios",
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.331",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.331",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "0.3.331",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "0.3.331",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "0.3.331",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "0.3.331",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "0.3.331",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.331"
  },
  "desktopName": "com.battlebuket.codes"
}
